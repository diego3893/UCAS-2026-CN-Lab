{
  "name": "ucas-slidev-presentation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "slidev slides.md",
    "build": "slidev build slides.md",
    "brief:check": "node scripts/check_brief.mjs brief.md slides.md",
    "check": "node scripts/check_deck.mjs",
    "export": "slidev export slides.md --format pptx-editable --output slides.pptx",
    "export:pdf": "slidev export slides.md --format pdf --output slides.pdf",
    "verify:pptx": "node scripts/verify_pptx.mjs slides.pptx --source slides.md --require-text"
  },
  "dependencies": {
    "slidev-theme-ucas": "https://github.com/RoxyXu151/slidev-theme-ucas/releases/download/v0.3.0/slidev-theme-ucas-0.3.0.tgz"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/parser": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "^1.61.1",
    "vue": "^3.5.42",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "floating-vue": "5.2.2",
    "dompurify": "^3.4.17",
    "image-size": "^2.0.3"
  }
}
